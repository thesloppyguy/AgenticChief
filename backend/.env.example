# SQLite file. Default: backend/data/chro.db (created and migrated on first run). Single writer, so run one API process.
# DATABASE_URL=sqlite:///./data/chro.db
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ANTHROPIC_API_KEY=
# Production web origin (Dokploy). Plain URL, comma-list, or JSON array all work.
# CORS_ORIGINS=https://chro.lokibots.ai



# --- Data sources -------------------------------------------------------------------------
# Stub data is served for any source whose live integration is off. Generate the fixture with:
#   uv run python -m scripts.generate_stub_data      (needs Anthropic credentials; costs tokens)
STUB_DATA_ENABLED=true
STUB_DATA_PATH=stub_data/stub_company_data.json
# STUB_GENERATOR_MODEL=claude-opus-5-5

# Live integrations: ALL OFF by default. Sources: successfactors, peoplestrong, myhealth, hi5plus.
# Not verified against real tenants; each needs a mapping file (see app/ingestion/live.py).
# INTEGRATIONS__SUCCESSFACTORS__ENABLED=false
# INTEGRATIONS__SUCCESSFACTORS__BASE_URL=https://<tenant>.example.com
# INTEGRATIONS__SUCCESSFACTORS__AUTH=bearer            # bearer | basic | client_credentials
# INTEGRATIONS__SUCCESSFACTORS__TOKEN=
# INTEGRATIONS__SUCCESSFACTORS__MAPPING_FILE=./integrations/successfactors.mapping.json

# --- AI-generated source systems (stand-ins for the real tenants) ------------------------------------
# The app serves HTTP endpoints in the shape of each source system; Claude generates each company's data once
# and stores it. Live adapters then call those endpoints like any real API. Set it up with:
#   uv run python -m scripts.setup_mock_sources --write-env
# Then restart uvicorn, POST /mock-sources/admin/generate, POST /sources/sync {"period":"YYYY-MM"}.
# MOCK_SOURCES_ENABLED=true
# MOCK_SOURCE_TOKEN=a-random-bearer-token
# MOCK_SOURCE_MODEL=                      # defaults to STUB_GENERATOR_MODEL
# MOCK_SOURCES_ALLOW_FALLBACK=false       # on an AI failure: false = 503, true = use seeded data (flagged synthetic)
# SOURCE_FRESHNESS_SLA_HOURS=72           # mark a source stale after this many hours without a successful pull

# --- Copilot memory ---------------------------------------------------------------------------------
# MEMORY_RETENTION_DAYS=90
# MEMORY_MAX_PER_USER=200

# --- Tests ---------------------------------------------------------------------------------------------
# CHRO_ENV_FILE=/path/to/other.env   # which env file to load; the test suite points this at nothing, so it never spends tokens

# --- Scheduler and workflows ----------------------------------------------------------------
# Runs scheduled jobs (Settings > Schedules) inside this process. Keep ONE API instance: SQLite is single-writer.
# SCHEDULER_ENABLED=true
# SCHEDULER_POLL_S=30
# A workflow with no heartbeat for this long is treated as interrupted and can be resumed.
# WORKFLOW_STALE_AFTER_S=300

# --- Approvals --------------------------------------------------------------------------------
# More targets than this in one action is "bulk" and denied. Four-eyes: an approver may not approve their own request.
# APPROVAL_BULK_MAX_TARGETS=5
# APPROVAL_ALLOW_SELF_APPROVAL=false

# --- Models (used when ANTHROPIC_API_KEY is set) -------------------------------------------------
# DEFAULT_MODEL=claude-sonnet-5-5
# DEEP_REASONING_MODEL=claude-opus-5-5   # agents configured for "deep" reasoning
# ROUTING_MODEL=claude-haiku-5-5         # agents configured for "fast"
